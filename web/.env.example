# Auth (generera: openssl rand -base64 32)
AUTH_SECRET=
# Publik app-URL — används av Auth.js och länkar i e-post. Lokalt:
AUTH_URL=http://localhost:3000
# På Vercel Production: sätt till https://web-ebon-eight-72.vercel.app (eller egen domän).
# Om dessa saknas eller pekar på localhost använder e-post VERCEL_URL som reserv.

# Första admin (skapas/uppdateras via npm run db:seed)
INITIAL_ADMIN_EMAIL=buud212@gmail.com
INITIAL_ADMIN_PASSWORD=

# Databas — Neon sätter dessa automatiskt via Vercel Marketplace
# DATABASE_URL              (pooled, för appen)
# DATABASE_URL_UNPOOLED     (direct, för prisma migrate)
# Alternativt lokalt:
# DATABASE_URL=postgresql://user:pass@localhost:5432/kartfiler
# DATABASE_URL_UNPOOLED=postgresql://user:pass@localhost:5432/kartfiler

# App
# Samma värde som AUTH_URL i produktion (länkar i notis-e-post m.m.)
NEXT_PUBLIC_APP_URL=http://localhost:3000
MAX_UPLOAD_BYTES=104857600
DIFF_SPATIAL_TOLERANCE_M=2

# Lagring — "local" (dev) eller "blob" (prod/Vercel)
# BLOB_READ_WRITE_TOKEN sätts automatiskt när Vercel Blob kopplas till projektet.
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
# BLOB_READ_WRITE_TOKEN=

# E-post (Gmail SMTP) — admin får notis vid ny registrering
# Kan konfigureras i admin-gränssnittet under /admin/settings (rekommenderas i prod).
# .env används som reserv vid uppstart eller om DB-inställningar är inaktiva.
# Kräver App Password (inte vanligt lösenord) om 2FA är aktiverat på Gmail-kontot.
# Se README.md för steg-för-steg.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Valfritt — standard är INITIAL_ADMIN_EMAIL
# ADMIN_NOTIFICATION_EMAIL=

# Checkout/checkin (E9)
CHECKOUT_REMINDER_DAYS=7
# CHECKOUT_ADMIN_NOTIFY_EMAIL=
# CRON_SECRET=                    # krävs för /api/cron/checkout-reminders i prod

# Lägg bana (E10)
COURSE_MAX_OBJECTS=500
COURSE_PDF_SCALE_MIN=4000
COURSE_PDF_SCALE_MAX=20000
COURSE_CONTROL_SYMBOLS=702,704,705,706,707,708,709

# Google OAuth — pausat tillsvidare
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
