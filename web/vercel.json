{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run check:help:deploy && npm run build",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/checkout-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "src/app/api/**/*.ts": {
      "maxDuration": 300,
      "memory": 3008
    }
  }
}
