generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String        @id @default(cuid())
  name               String?
  email              String        @unique
  emailVerified      DateTime?
  image              String?
  passwordHash       String?
  role               String        @default("PENDING")
  approvedAt         DateTime?
  approvedById       String?
  lastLoginAt        DateTime?
  receiveNotifications Boolean       @default(false)
  receiveOcdAttachment Boolean       @default(false)
  mustChangePassword   Boolean       @default(false)
  passwordExpiresAt    DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  accounts           Account[]
  sessions           Session[]
  checkouts          MapCheckout[] @relation("CheckoutUser")
  cancelledCheckouts MapCheckout[] @relation("CheckoutCancelledBy")
  courses            Course[]
  suggestionsCreated MapSuggestion[] @relation("SuggestionAuthor")
  suggestionsReviewed MapSuggestion[] @relation("SuggestionReviewer")
  feedbackCreated    FeedbackItem[]  @relation("FeedbackAuthor")
  feedbackReviewed   FeedbackItem[]  @relation("FeedbackReviewer")
  feedbackVotes      FeedbackVote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MapFile {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String?
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  createdById String?
  versions    MapVersion[]
  checkouts   MapCheckout[]
  courses     Course[]
  suggestions MapSuggestion[]
}

model MapVersion {
  id               String   @id @default(cuid())
  mapFileId        String
  versionNumber    Int
  storagePath      String
  originalFilename String
  fileSizeBytes    Int
  contentHash      String?
  uploadedById     String?
  uploadedAt       DateTime @default(now())
  comment          String?
  isRecommended    Boolean  @default(false)
  isPublished      Boolean  @default(false)
  previewSvgPath   String?
  objectCount      Int?
  parseStatus      String   @default("PENDING")
  parseError       String?
  mapFile               MapFile       @relation(fields: [mapFileId], references: [id], onDelete: Cascade)
  checkoutsAsBase       MapCheckout[] @relation("CheckoutBaseVersion")
  checkoutsAsIntegrated MapCheckout[] @relation("CheckoutIntegratedVersion")
  suggestions           MapSuggestion[]
  suggestionsIntegrated MapSuggestion[] @relation("SuggestionIntegratedVersion")

  @@unique([mapFileId, versionNumber])
}

model MapCheckout {
  id                  String    @id @default(cuid())
  mapFileId           String
  baseVersionId       String
  userId              String
  status              String    @default("ACTIVE")
  selectionType       String
  selectionJson       String
  exportStoragePath   String?
  checkinStoragePath  String?
  diffSummaryJson     String?
  userConfirmedAt     DateTime?
  adminConfirmedAt    DateTime?
  integratedAt        DateTime?
  integratedVersionId String?
  cancelledAt         DateTime?
  cancelledById       String?
  cancelReason        String?
  integrationComment  String?
  reminderSentAt      DateTime?
  exportOcadVersion   Int       @default(12)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  mapFile           MapFile     @relation(fields: [mapFileId], references: [id], onDelete: Cascade)
  baseVersion       MapVersion  @relation("CheckoutBaseVersion", fields: [baseVersionId], references: [id])
  user              User        @relation("CheckoutUser", fields: [userId], references: [id])
  integratedVersion MapVersion? @relation("CheckoutIntegratedVersion", fields: [integratedVersionId], references: [id])
  cancelledBy       User?       @relation("CheckoutCancelledBy", fields: [cancelledById], references: [id])
  suggestions       MapSuggestion[]

  @@index([mapFileId, status])
}

model VersionDiff {
  id          String    @id @default(cuid())
  mapFileId   String
  versionAId  String
  versionBId  String
  status      String    @default("PENDING")
  summaryJson String?
  changesJson String?
  computedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@unique([versionAId, versionBId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  metadata   String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
}

model AppSettings {
  id                         String   @id @default("default")
  smtpHost                   String?
  smtpPort                   Int?
  smtpUser                   String?
  smtpPassEncrypted          String?
  adminNotificationEmail     String?
  checkoutReminderDays       Int      @default(7)
  checkoutReminderRepeatDays Int      @default(7)
  enabled                    Boolean  @default(false)
  updatedAt                  DateTime @updatedAt
}

model Course {
  id          String         @id @default(cuid())
  mapFileId   String
  name        String
  createdById String
  isPublic    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  mapFile     MapFile        @relation(fields: [mapFileId], references: [id], onDelete: Cascade)
  createdBy   User           @relation(fields: [createdById], references: [id])
  objects     CourseObject[]

  @@index([mapFileId, isPublic])
}

model CourseObject {
  id           String   @id @default(cuid())
  courseId     String
  symbolNr     Int
  objectType   String
  geometryJson String
  textContent  String?
  sortOrder    Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, sortOrder])
}

model MapSuggestion {
  id                  String   @id @default(cuid())
  mapFileId           String
  mapVersionId        String
  createdById         String
  status              String   @default("OPEN")
  category            String
  locationConfidence  String   @default("GANSKA_SAKER")
  title               String?
  comment             String
  reviewComment       String?
  reviewedById        String?
  reviewedAt          DateTime?
  checkoutId          String?
  integratedVersionId String?
  attachmentPath      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  mapFile           MapFile     @relation(fields: [mapFileId], references: [id], onDelete: Cascade)
  mapVersion        MapVersion  @relation(fields: [mapVersionId], references: [id], onDelete: Cascade)
  createdBy         User        @relation("SuggestionAuthor", fields: [createdById], references: [id])
  reviewedBy        User?       @relation("SuggestionReviewer", fields: [reviewedById], references: [id])
  checkout          MapCheckout? @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  integratedVersion MapVersion? @relation("SuggestionIntegratedVersion", fields: [integratedVersionId], references: [id], onDelete: SetNull)
  objects           MapSuggestionObject[]

  @@index([mapFileId, status])
  @@index([mapVersionId])
  @@index([createdById])
}

model MapSuggestionObject {
  id           String   @id @default(cuid())
  suggestionId String
  objectType   String
  geometryJson String
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  suggestion MapSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@index([suggestionId, sortOrder])
}

model FeedbackItem {
  id                String   @id @default(cuid())
  type              String
  title             String
  description       String
  stepsToReproduce  String?
  status            String   @default("OPEN")
  adminComment      String?
  createdById       String
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy  User           @relation("FeedbackAuthor", fields: [createdById], references: [id])
  reviewedBy User?          @relation("FeedbackReviewer", fields: [reviewedById], references: [id])
  votes      FeedbackVote[]

  @@index([type, status])
  @@index([createdById])
  @@index([createdAt])
}

model FeedbackVote {
  id             String   @id @default(cuid())
  feedbackItemId String
  userId         String
  createdAt      DateTime @default(now())

  feedbackItem FeedbackItem @relation(fields: [feedbackItemId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([feedbackItemId, userId])
  @@index([feedbackItemId])
}
